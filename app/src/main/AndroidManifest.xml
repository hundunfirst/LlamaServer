<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 全盘文件访问：targetSdk 28 下授予后即 legacy storage，可直接读写 /sdcard 任意路径。
         用途：把 /storage bind 进 Linux 环境（proot），让 run_bash 能操作文件工具授权目录之外的真实文件；
         这也是文件工具从「单 SAF 目录」升级成「全盘」的前提（2026-10-30 用户决定，替代 10-25 的不做）。 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- run_bash：apt / npm 前判断网络是否可用，避免让模型对着超时瞎猜 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- run_bash：apt install / 构建类长命令会被省电策略掐断，需引导用户放行后台 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 会话里生成的 APK 可以点一下直接进安装流程（首次会跳「允许安装未知应用」） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 定时任务是靠系统闹钟驱动的，重启后闹钟会全部丢失，必须争取开机广播重新登记 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 接收其它 App 分享的文本/链接 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 会话里产出的文件交给系统应用打开：授权目录内的走 documents provider，
             真实路径（run_bash 里写出来的）走这里转成 content:// —— targetSdk≥24 不能甩 file:// -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".core.ServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="on_device_llm_inference_server" />
        </service>

        <!-- 无障碍服务：读屏 + 模拟点击/滑动/输入 + 截图。不需要 adb、不需要网络，授权一次重启仍有效 -->
        

        <!-- 定时任务到点唤醒：只做「排入队列 + 发通知」，不在这里起引擎 -->
        <receiver
            android:name=".core.TaskAlarmReceiver"
            android:exported="false" />

        <!-- 开机后重新登记定时任务：闹钟存在系统里，重启就没了。
             用户在 MIUI 上还要允许本应用「自启动」，否则收不到这条广播。 -->
        <receiver
            android:name=".core.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
