+// 解析 LLAMA_LAZY_TENSORS：逗号分隔的子串名单，命中即强制按需读。
+// 用子串而不是正则，是因为调用方只写得出 "ffn_up_exps" 这种稳定片段，
+// 而且这里在加载期对每个张量都要判一次，越便宜越好。
+std::vector<std::string> llama_model_loader::lazy_read::parse_forced_patterns() {
+    std::vector<std::string> out;
+    const char * env = std::getenv("LLAMA_LAZY_TENSORS");
+    if (env == nullptr || *env == '\0') {
+        return out;
+    }
+    std::string s(env);
+    size_t start = 0;
+    while (start <= s.size()) {
+        const size_t comma = s.find(',', start);
+        std::string item = comma == std::string::npos ? s.substr(start) : s.substr(start, comma - start);
+        // trim 空白（Windows 上传环境变量时容易带空格）
+        const size_t b = item.find_first_not_of(" \t\r\n");
+        const size_t e = item.find_last_not_of(" \t\r\n");
+        if (b != std::string::npos) {
+            out.push_back(item.substr(b, e - b + 1));
+        }
+        if (comma == std::string::npos) {
+            break;
+        }
+        start = comma + 1;
+    }
+    LLAMA_LOG_INFO("%s: LLAMA_LAZY_TENSORS 生效，%zu 条模式强制按需读\n", __func__, out.size());
+    return out;
+}
+
+bool llama_model_loader::lazy_read::forced(const std::string & name) const {
+    for (const auto & p : forced_patterns) {
+        if (name.find(p) != std::string::npos) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool llama_model_loader::lazy_read::add(const std::string & name, const ggml_tensor * t, const llama_tensor_weight * w, bool force) {
+    if (!force && mode == LLAMA_LAZY_MODE_OFF) {
         return false;
     }
 
     // do not lazy-read small tensors, it has significant overhead and is not worth it
+    // （显式指定的张量不受这个阈值限制——调用方比自己更清楚该不该懒读）
     constexpr size_t auto_min_size = 4ull * 1024 * 1024 * 1024;
-    if (mode != LLAMA_LAZY_MODE_ON && ggml_nbytes(t) <= auto_min_size) {
+    if (!force && mode != LLAMA_LAZY_MODE_ON && ggml_nbytes(t) <= auto_min_size) {
         return false;
     }
 
